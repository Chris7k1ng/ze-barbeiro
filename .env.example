# Copie este arquivo para ".env.local" e preencha. O ".env.local" NUNCA deve ser enviado ao GitHub
# nem compartilhado (ele já está no .gitignore).

# Endereço do banco no Neon: painel do Neon > Connect > "Connection string".
DATABASE_URL=postgresql://USUARIO:SENHA@HOST.neon.tech/neondb?sslmode=require

# Senha para entrar no painel do barbeiro (/admin). Escolha uma forte, com 10 caracteres ou mais.
ADMIN_PASSWORD=troque-esta-senha

# Opcional: texto aleatório usado para assinar o login. Se ficar vazio, usa a ADMIN_PASSWORD.
# ADMIN_SESSION_SECRET=ADMIN_PASSWORD
